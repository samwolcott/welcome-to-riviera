---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;

const nav = [
  { label: 'MUSIC', href: '#music' },
  { label: 'LIVE', href: '#live' },
  { label: 'ABOUT', href: '#about' },
  { label: 'CONTACT', href: '#contact' },
];

const shows = [
  {
    date: 'AUG 22, 2026',
    venue: 'Spanish Ballroom',
    city: 'Tacoma, WA',
    tickets: 'https://example.com/tickets',
  },
  {
    date: 'SEP 12, 2026',
    venue: 'The Crocodile',
    city: 'Seattle, WA',
    tickets: 'https://example.com/tickets',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Riviera — official music, live dates, and contact information."
    />
    <title>Riviera</title>
  </head>

  <body>
    <main>

      <!-- HERO -->
      <section class="hero" aria-label="Riviera">
        <img
          class="hero-photo"
          src={`${base}/images/riviera-hero.jpg`}
          alt="Riviera musician standing by the ocean with a guitar"
        />

        <div class="hero-ui">
          <img
            class="logo"
            src={`${base}/images/riviera-logo.png`}
            alt="Riviera"
          />

          <nav class="main-nav" aria-label="Main navigation">
            {nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <div class="socials" aria-label="Social links">

            <!-- Instagram -->
            <a href="#" aria-label="Instagram" title="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.25" />
                <circle class="fill" cx="17.5" cy="6.5" r="1.1" />
              </svg>
            </a>

            <!-- Spotify -->
            <a href="#" aria-label="Spotify" title="Spotify">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9.25" />
                <path d="M7 9.2c3.6-1 7.7-.6 10.5.9M7.8 12.2c3-.8 6.4-.45 8.8.75M8.6 15.1c2.4-.6 5-.3 7 .7" />
              </svg>
            </a>

            <!-- Apple Music -->
            <a href="#" aria-label="Apple Music" title="Apple Music">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  class="fill"
                  d="M16.8 12.6c0-2.6 2.1-3.9 2.2-4-1.2-1.8-3.1-2-3.8-2-1.6-.2-3.1 1-3.9 1s-2-1-3.4-1c-1.8 0-3.5 1.1-4.4 2.7-1.9 3.3-.5 8.2 1.3 10.9.9 1.3 2 2.8 3.4 2.7 1.3-.1 1.9-.9 3.5-.9s2.1.9 3.5.8c1.5 0 2.4-1.3 3.3-2.6 1-1.5 1.5-3 1.5-3.1-.1 0-3.2-1.2-3.2-4.5ZM14.2 4.9c.7-.9 1.2-2.1 1.1-3.3-1.1 0-2.4.7-3.2 1.6-.7.8-1.3 2-1.1 3.2 1.2.1 2.5-.6 3.2-1.5Z"
                />
              </svg>
            </a>

            <!-- YouTube -->
            <a href="#" aria-label="YouTube" title="YouTube">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  class="fill"
                  d="M21.5 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.4.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 2 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.8.5 7.4.5 7.4.5s5.6 0 7.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12a31 31 0 0 0-.5-4.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z"
                />
              </svg>
            </a>

          </div>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          SCROLL
        </div>
      </section>


      <!-- MUSIC -->
      <section id="music" class="content-section light">
        <p class="eyebrow">LISTEN</p>
        <h2>MUSIC</h2>

        <p class="placeholder-copy">
          Latest release artwork and streaming links go here.
        </p>
      </section>


      <!-- LIVE -->
      <section id="live" class="live-section">

        <div class="live-heading">
          <p class="eyebrow">UPCOMING</p>
          <h2>LIVE</h2>
        </div>

        <div class="shows">

          {shows.map((show) => (
            <article class="show-row">

              <div class="show-info">
                <div class="show-date">
                  {show.date}
                </div>

                <div class="show-venue">
                  {show.venue}
                </div>
              </div>

              <div class="show-city">
                {show.city}
              </div>

              <div class="show-ticket">
                <a
                  href={show.tickets}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  TICKETS
                </a>
              </div>

            </article>
          ))}

        </div>
      </section>


      <!-- ABOUT -->
      <section id="about" class="content-section sand">
        <p class="eyebrow">THE STORY</p>

        <h2>ABOUT RIVIERA</h2>

        <p class="placeholder-copy">
          This section is ready for the band's bio and another strong press photo.
        </p>
      </section>


      <!-- CONTACT -->
      <section id="contact" class="content-section light">
        <p class="eyebrow">BOOKING / PRESS</p>

        <h2>CONTACT</h2>

        <a
          class="email"
          href="mailto:hello@example.com"
        >
          HELLO@EXAMPLE.COM
        </a>
      </section>

    </main>
  </body>
</html>