---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;

const nav = [
  { label: 'ABOUT', href: '#about' },
  { label: 'LIVE', href: '#live' },
  { label: 'CONTACT', href: '#contact' },
];

const shows = [
  {
    date: 'AUG 22, 2026',
    venue: 'The Grove @ Farm 12',
    city: 'Puyallup, WA',
    tickets: 'https://www.farm12.org/calendar/2026/8/22/blueberry-fest',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link
      rel="icon"
      type="image/png"
      href={`${base}favicon.png`}
    />

    <meta
      name="description"
      content="Riviera — official music, live dates, and contact information."
    />

    <title>Riviera</title>
  </head>

  <body>
    <main>

      <!-- HERO -->
      <section class="hero" aria-label="Riviera">
        <img
          class="hero-photo"
          src={`${base}images/riviera-hero.jpg`}
          alt="Riviera musician standing by the ocean with a guitar"
        />

        <div class="hero-ui">
          <img
            class="logo"
            src={`${base}images/riviera-logo.png`}
            alt="Riviera"
          />

          <!-- NAVIGATION -->
          <nav class="main-nav" aria-label="Main navigation">
            {nav.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>

          <!-- SOCIAL LINKS -->
          <div class="socials" aria-label="Social links">

            <!-- Instagram -->
            <a
              href="https://www.instagram.com/welcome_to_riviera/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="3"
                  y="3"
                  width="18"
                  height="18"
                  rx="5"
                />
                <circle
                  cx="12"
                  cy="12"
                  r="4.25"
                />
                <circle
                  class="fill"
                  cx="17.5"
                  cy="6.5"
                  r="1.1"
                />
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href="https://www.facebook.com/profile.php?id=61591573870392"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              title="Facebook"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  class="fill"
                  d="M13.7 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5H17V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.8v8h3.4Z"
                />
              </svg>
            </a>

            <!-- Spotify -->
            <a
              href="https://open.spotify.com/artist/3RgYvYI6gv3cj6H0NclscK?si=zxAncx5gTFOJ7bwxiGV72A"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Spotify"
              title="Spotify"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle
                  cx="12"
                  cy="12"
                  r="9.25"
                />
                <path
                  d="M7 9.2c3.6-1 7.7-.6 10.5.9
                     M7.8 12.2c3-.8 6.4-.45 8.8.75
                     M8.6 15.1c2.4-.6 5-.3 7 .7"
                />
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="https://www.youtube.com/@welcometoriviera"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              title="YouTube"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  class="fill"
                  d="M21.5 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.4.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 2 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.8.5 7.4.5 7.4.5s5.6 0 7.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 22 12a31 31 0 0 0-.5-4.8ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z"
                />
              </svg>
            </a>

            <!-- TikTok -->
            <a
              href="https://www.tiktok.com/@welcometoriviera"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              title="TikTok"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M15 4v10.5a5 5 0 1 1-4-4.9"
                />
                <path
                  d="M15 4c.6 2.6 2.1 4.1 4.5 4.6"
                />
              </svg>
            </a>

          </div>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          SCROLL
        </div>
      </section>


      <!-- ABOUT -->
      <section id="about" class="content-section sand">
        <p class="eyebrow">THE STORY</p>

        <h2>ABOUT RIVIERA</h2>

        <div class="about-copy">
          <p>
            Riviera is the musical and visual world of producer and filmmaker Michael Rabb.
            Born from a desire to rediscover the joy of creating during a season of anxiety,
            the project explores the art of easy living through music, cinematic storytelling,
            and an imagined world that invites us to slow down and rediscover the richness of
            everyday life.
          </p>

          <p>
            Drawing from yacht rock, soul-pop, jazz harmony, and modern indie production,
            Riviera creates music that invites listeners to slow down and rediscover the beauty
            of everyday life. Built around the creative vision of Michael Rabb and shaped with
            collaborators from around the world, Riviera is both a musical project and an
            imagined world—a place where beauty, leisure, and emotional honesty still matter.
          </p>

          <p>
            Every song feels like the soundtrack to a vacation you somehow remember but never
            actually took. But Riviera isn’t about escaping life. It’s about rediscovering the
            beauty of the one you’re already living.
          </p>
        </div>
      </section>


      <!-- LIVE -->
      <section id="live" class="live-section">

        <div class="live-heading">
          <p class="eyebrow">UPCOMING</p>
          <h2>LIVE</h2>
        </div>

        <div class="shows">
          {shows.map((show) => (
            <article class="show-row">

              <div class="show-info">
                <div class="show-date">
                  {show.date}
                </div>

                <div class="show-venue">
                  {show.venue}
                </div>
              </div>

              <div class="show-city">
                {show.city}
              </div>

              <div class="show-ticket">
                <a
                  href={show.tickets}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  TICKETS
                </a>
              </div>

            </article>
          ))}
        </div>

      </section>


      <!-- CONTACT -->
      <section id="contact" class="content-section light">
        <p class="eyebrow">BOOKING / PRESS</p>

        <h2>CONTACT</h2>

        <a
          class="email"
          href="mailto:hello@welcometoriviera.com"
        >
          HELLO@WELCOMETORIVIERA.COM
        </a>
      </section>

    </main>
  </body>
</html>